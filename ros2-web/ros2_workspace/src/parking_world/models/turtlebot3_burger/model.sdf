<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="turtlebot3_burger">
    <link name="base_footprint">
      <inertial>
        <mass>0.944</mass>
        <inertia>
          <ixx>0.00718</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00722</iyy><iyz>0</iyz>
          <izz>0.00414</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.032 0 0.08 0 0 0</pose>
        <geometry><box><size>0.14 0.14 0.143</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.032 0 0.01 0 0 0</pose>
        <geometry><box><size>0.14 0.14 0.143</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>

      <!-- 라이다 시각화 -->
      <visual name="lidar_visual">
        <pose>-0.032 0 0.182 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.0315</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>

      <!-- 라이다 센서 -->
      <sensor name="lidar" type="gpu_lidar">
  <pose>-0.032 0 0.182 0 0 0</pose>
  <always_on>true</always_on>
  <visualize>true</visualize>
  <update_rate>5</update_rate>
  <lidar>
    <scan>
      <horizontal>
        <samples>360</samples>
        <resolution>1.0</resolution>
        <min_angle>0.0</min_angle>
        <max_angle>6.28319</max_angle>
      </horizontal>
    </scan>
    <range>
      <min>0.12</min>
      <max>3.5</max>
      <resolution>0.015</resolution>
    </range>
    <noise>
      <type>gaussian</type>
      <mean>0.0</mean>
      <stddev>0.01</stddev>
    </noise>
  </lidar>
  <plugin filename="ignition-gazebo-gpu-lidar-sensor-system"
          name="ignition::gazebo::systems::GpuLidarSensor"/>
</sensor>
    </link>

    <!-- 왼쪽 바퀴 -->
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_footprint</parent>
      <child>wheel_left_link</child>
      <pose>0 0.08 0.033 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>
    <link name="wheel_left_link">
      <pose>0 0.08 0.033 0 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.12e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.12e-05</iyy><iyz>0</iyz><izz>2.07e-05</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- 오른쪽 바퀴 -->
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_footprint</parent>
      <child>wheel_right_link</child>
      <pose>0 -0.08 0.033 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>
    <link name="wheel_right_link">
      <pose>0 -0.08 0.033 0 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.12e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.12e-05</iyy><iyz>0</iyz><izz>2.07e-05</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- DiffDrive 플러그인 -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

  </model>
</sdf>